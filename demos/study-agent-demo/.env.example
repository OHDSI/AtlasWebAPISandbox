# Copy to .env for this local meeting profile only. Do not commit .env.
# The properties below map directly to WebAPI's Spring configuration.

# Atlas dev-server origin and WebAPI endpoint (the browser uses the /WebAPI proxy).
ATLAS_ORIGIN=http://localhost:5173
WEBAPI_URL=http://localhost:8080

# WebAPI database. Use an existing local demonstration database; do not use production.
DATASOURCE_URL=jdbc:postgresql://localhost:5432/atlas_demo
DATASOURCE_USERNAME=replace-with-local-user
DATASOURCE_PASSWORD=replace-with-local-password
DATASOURCE_OHDSI_SCHEMA=webapi
SECURITY_AUTH_DB_DATASOURCE_URL=jdbc:postgresql://localhost:5432/atlas_demo
SECURITY_AUTH_DB_DATASOURCE_USERNAME=replace-with-local-user
SECURITY_AUTH_DB_DATASOURCE_PASSWORD=replace-with-local-password
SECURITY_AUTH_DB_DATASOURCE_SCHEMA=webapi

# WebAPI calls ACP server-side. Do not expose this value to the browser.
STUDY_AGENT_ACP_BASE_URL=http://127.0.0.1:8765
STUDY_AGENT_CONCEPT_SET_SEARCH_ENABLED=true
STUDY_AGENT_COHORT_DEFINITION_ENABLED=true

# ACP calls MCP server-side. Keep model/vocabulary credentials in the ignored
# StudyAgent secrets.env, not in this file.
STUDY_AGENT_MCP_URL=http://127.0.0.1:8000

# Only needed if your local security configuration requires it.
SECURITY_JWT_SECRET=replace-with-a-long-random-local-secret
